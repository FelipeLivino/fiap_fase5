# Execução da aplicação
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
CARDIOIA_HOST_PORT=5000
LOG_LEVEL=INFO

# Conversa
ASSISTANT_MODE=mock
MAX_MESSAGE_CHARS=1000
CONVERSATION_TTL_SECONDS=900

# IBM Watson Assistant — selecionar um único perfil na Fase 3
WATSON_API_KEY=
WATSON_API_PROFILE=v2
WATSON_SERVICE_URL=
WATSON_ASSISTANT_ID=
WATSON_ENVIRONMENT_ID=
WATSON_WORKSPACE_ID=
WATSON_API_VERSION=2024-08-25
WATSON_TIMEOUT_SECONDS=10

# Google AI Studio — usado somente pelo perfil genai-live
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Bancos e usuário de menor privilégio — usados somente pelo perfil rpa
POSTGRES_ROOT_PASSWORD=
RPA_POSTGRES_PASSWORD=
MONGO_ROOT_PASSWORD=
RPA_MONGO_PASSWORD=
