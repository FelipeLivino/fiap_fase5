FROM alpine:3.22

RUN apk add --no-cache ffmpeg font-dejavu py3-pillow python3 \
    && addgroup -g 10001 cardioia \
    && adduser -D -u 10001 -G cardioia cardioia

WORKDIR /work
COPY --chown=10001:10001 scripts/generate_video_assets.py /tools/generate_video_assets.py
USER 10001:10001

ENTRYPOINT ["ffmpeg"]
